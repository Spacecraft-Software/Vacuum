# Build artifacts
/target
**/*.rs.bk

# Local working documents (kept out of the repo per maintainer request)
/PLAN.md
/CLAUDE.md

# Document derivatives (canonical sources only, per spacecraft-document-format)
*.docx
*.odt
*.pdf
doc/*.info
doc/*.html

# Nix build symlinks (`nix build` writes ./result)
/result
/result-*

# direnv's per-directory cache; .envrc itself is tracked
/.direnv

# Editor / OS noise
.DS_Store
*.swp

# Engram session archives (`engram save-chat`). Regenerable from the memory
# store, one file per save, and large enough to bury real history in the diff.
chat/
